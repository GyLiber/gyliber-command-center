APP_ENV=development
PORT=3000
COOKIE_SECURE=false
RUST_LOG=info

# At least 64 random bytes. Never commit the real value.
SESSION_MASTER_KEY=replace-with-at-least-64-random-bytes

# Create a GitHub OAuth App. Callback URL must exactly match.
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# Comma-separated GitHub usernames authorized as GyLiber members.
GYLIBER_ALLOWED_GITHUB_LOGINS=GyLiber
