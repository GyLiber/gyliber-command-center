APP_ENV=development
PORT=3000
COOKIE_SECURE=false
RUST_LOG=info

# At least 64 random bytes. Never commit the real value.
SESSION_MASTER_KEY=replace-with-at-least-64-random-bytes

# Create a GitHub OAuth App. Callback URL must exactly match.
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# PostgreSQL session persistence. Required in production.
# Use a private/internal connection string for the managed deployment.
DATABASE_URL=postgresql://user:password@localhost:5432/gyliber_command_center

# Comma-separated GitHub usernames authorized as GyLiber members.
GYLIBER_ALLOWED_GITHUB_LOGINS=GyLiber

# Optional member mathematical playground AI/publishing. Leave unset for demos only.
# Select one provider explicitly; the server never falls back to another provider.
# MATH_AI_PROVIDER=gemini
# MATH_GEMINI_API_KEY=your-google-ai-studio-api-key
# MATH_GEMINI_MODEL=gemini-2.5-flash
# Alternative: MATH_AI_PROVIDER=openai (also the legacy default when unset).
# Set both selected provider values together in the hosting secret environment.
# MATH_OPENAI_API_KEY=your-project-api-key
# MATH_OPENAI_MODEL=an-exact-compatible-model-id
# MATH_GITHUB_TOKEN=repository-scoped-contents-write-token
